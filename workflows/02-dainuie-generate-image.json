{
  "name": "Dainuie – Generate Image (tool)",
  "id": "dainuie-gen-image",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "pinData": {},
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "prompt", "type": "string" },
            { "name": "aspect", "type": "string" },
            { "name": "chat_id", "type": "string" }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "IMAGE_MODEL", "value": "gpt-image-1", "type": "string" },
            { "id": "c2", "name": "IMAGE_QUALITY", "value": "medium", "type": "string" },
            { "id": "c3", "name": "BRAND_STYLE", "value": "REPLACE: consistent visual style for dainuie.online, e.g. warm natural light, earthy palette, clean minimal composition, photorealistic, no text or logos.", "type": "string" },
            { "id": "c4", "name": "CLOUDINARY_CLOUD_NAME", "value": "REPLACE_WITH_CLOUDINARY_CLOUD_NAME", "type": "string" },
            { "id": "c5", "name": "CLOUDINARY_UPLOAD_PRESET", "value": "REPLACE_WITH_UNSIGNED_UPLOAD_PRESET", "type": "string" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $json.IMAGE_MODEL,\n  prompt: $json.prompt + '\\n\\nStyle guide: ' + $json.BRAND_STYLE,\n  size: ({ square: '1024x1024', portrait: '1024x1536', landscape: '1536x1024' })[String($json.aspect || 'square').toLowerCase()] || '1024x1024',\n  quality: $json.IMAGE_QUALITY,\n  n: 1,\n  output_format: 'png'\n} }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Generate Image (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudinary.com/v1_1/{{ $('Config').item.json.CLOUDINARY_CLOUD_NAME }}/image/upload",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "file", "value": "=data:image/png;base64,{{ $json.data[0].b64_json }}" },
            { "name": "upload_preset", "value": "={{ $('Config').item.json.CLOUDINARY_UPLOAD_PRESET }}" },
            { "name": "folder", "value": "dainuie/generated" }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Upload to Cloudinary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $('Start').item.json.chat_id }}",
        "file": "={{ $json.secure_url }}",
        "additionalFields": {
          "caption": "🖼️ Generated image preview. Approve it or ask me to regenerate.",
          "appendAttribution": false
        }
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Preview on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "image_url", "value": "={{ $('Upload to Cloudinary').item.json.secure_url }}", "type": "string" },
            { "id": "r2", "name": "width", "value": "={{ $('Upload to Cloudinary').item.json.width }}", "type": "number" },
            { "id": "r3", "name": "height", "value": "={{ $('Upload to Cloudinary').item.json.height }}", "type": "number" },
            { "id": "r4", "name": "message", "value": "Image generated. A preview was sent to the owner on Telegram; ask whether it is approved.", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Return",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Generate Image (OpenAI)", "type": "main", "index": 0 }]] },
    "Generate Image (OpenAI)": { "main": [[{ "node": "Upload to Cloudinary", "type": "main", "index": 0 }]] },
    "Upload to Cloudinary": { "main": [[{ "node": "Preview on Telegram", "type": "main", "index": 0 }]] },
    "Preview on Telegram": { "main": [[{ "node": "Return", "type": "main", "index": 0 }]] }
  }
}
