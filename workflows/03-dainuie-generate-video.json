{
  "name": "Dainuie – Generate Video (tool)",
  "id": "dainuie-gen-video",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "pinData": {},
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "prompt", "type": "string" },
            { "name": "duration", "type": "string" },
            { "name": "chat_id", "type": "string" }
          ]
        }
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "FAL_MODEL", "value": "fal-ai/kling-video/v2.1/standard/text-to-video", "type": "string" },
            { "id": "c2", "name": "ASPECT_RATIO", "value": "9:16", "type": "string" },
            { "id": "c3", "name": "NEGATIVE_PROMPT", "value": "blur, distortion, low quality, text, watermark, logo", "type": "string" },
            { "id": "c4", "name": "BRAND_STYLE", "value": "REPLACE: consistent video style for dainuie.online, e.g. warm natural light, smooth slow camera movement, cinematic, realistic.", "type": "string" },
            { "id": "c5", "name": "CLOUDINARY_CLOUD_NAME", "value": "REPLACE_WITH_CLOUDINARY_CLOUD_NAME", "type": "string" },
            { "id": "c6", "name": "CLOUDINARY_UPLOAD_PRESET", "value": "REPLACE_WITH_UNSIGNED_UPLOAD_PRESET", "type": "string" },
            { "id": "c7", "name": "MAX_POLLS", "value": 24, "type": "number" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://queue.fal.run/{{ $json.FAL_MODEL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  prompt: $json.prompt + '. ' + $json.BRAND_STYLE,\n  negative_prompt: $json.NEGATIVE_PROMPT,\n  duration: ['5', '10'].includes(String($json.duration)) ? String($json.duration) : '5',\n  aspect_ratio: $json.ASPECT_RATIO\n} }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Submit Video Job (fal.ai)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 300],
      "webhookId": "dainuie-video-wait"
    },
    {
      "parameters": {
        "url": "={{ $('Submit Video Job (fal.ai)').item.json.status_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "done1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "COMPLETED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "to1",
              "leftValue": "={{ $runIndex >= $('Config').first().json.MAX_POLLS }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000007",
      "name": "Timed Out?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 540]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "error", "value": "=Video generation did not finish in time (status: {{ $json.status }}). Ask the owner whether to retry.", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000008",
      "name": "Return Timeout",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1340, 620]
    },
    {
      "parameters": {
        "url": "={{ $('Submit Video Job (fal.ai)').item.json.response_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000009",
      "name": "Fetch Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudinary.com/v1_1/{{ $('Config').item.json.CLOUDINARY_CLOUD_NAME }}/video/upload",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "file", "value": "={{ $json.video?.url || $json.video_url || $json.output?.url }}" },
            { "name": "upload_preset", "value": "={{ $('Config').item.json.CLOUDINARY_UPLOAD_PRESET }}" },
            { "name": "folder", "value": "dainuie/generated" }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "c3000000-0000-4000-8000-000000000010",
      "name": "Upload to Cloudinary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "operation": "sendVideo",
        "chatId": "={{ $('Start').item.json.chat_id }}",
        "file": "={{ $json.secure_url }}",
        "additionalFields": {
          "caption": "🎬 Generated video preview. Approve it or ask me to regenerate.",
          "appendAttribution": false
        }
      },
      "id": "c3000000-0000-4000-8000-000000000011",
      "name": "Preview on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1780, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "video_url", "value": "={{ $('Upload to Cloudinary').item.json.secure_url }}", "type": "string" },
            { "id": "r2", "name": "duration_seconds", "value": "={{ $('Upload to Cloudinary').item.json.duration }}", "type": "number" },
            { "id": "r3", "name": "message", "value": "Video generated. A preview was sent to the owner on Telegram; ask whether it is approved.", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000012",
      "name": "Return",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 200]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Submit Video Job (fal.ai)", "type": "main", "index": 0 }]] },
    "Submit Video Job (fal.ai)": { "main": [[{ "node": "Wait 20s", "type": "main", "index": 0 }]] },
    "Wait 20s": { "main": [[{ "node": "Check Status", "type": "main", "index": 0 }]] },
    "Check Status": { "main": [[{ "node": "Completed?", "type": "main", "index": 0 }]] },
    "Completed?": {
      "main": [
        [{ "node": "Fetch Result", "type": "main", "index": 0 }],
        [{ "node": "Timed Out?", "type": "main", "index": 0 }]
      ]
    },
    "Timed Out?": {
      "main": [
        [{ "node": "Return Timeout", "type": "main", "index": 0 }],
        [{ "node": "Wait 20s", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Result": { "main": [[{ "node": "Upload to Cloudinary", "type": "main", "index": 0 }]] },
    "Upload to Cloudinary": { "main": [[{ "node": "Preview on Telegram", "type": "main", "index": 0 }]] },
    "Preview on Telegram": { "main": [[{ "node": "Return", "type": "main", "index": 0 }]] }
  }
}
